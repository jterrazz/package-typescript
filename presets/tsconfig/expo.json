{
    "display": "Expo",
    "include": ["${configDir}/**/*.ts", "${configDir}/**/*.tsx"],
    "exclude": ["${configDir}/node_modules"],

    "compilerOptions": {
        "allowJs": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "incremental": true,
        "jsx": "react-native",
        "lib": ["DOM", "ESNext"],
        "moduleResolution": "node",
        "noEmit": true,
        "paths": {
            "@/*": ["src/*"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "ESNext",
        "tsBuildInfoFile": "${configDir}/.artifacts/tsc/tsconfig.tsbuildinfo"
    }
}
