{
    "display": "Library (ESM, declaration-emitting)",
    "extends": "./node.json",
    "compilerOptions": {
        "allowJs": false,
        "declaration": true,
        "erasableSyntaxOnly": true,
        "isolatedDeclarations": true
    },
    "include": ["${configDir}/**/*.ts"],
    "exclude": [
        "${configDir}/node_modules",
        "${configDir}/dist",
        "${configDir}/.artifacts",
        "${configDir}/**/_fixtures",
        "${configDir}/**/_expected"
    ]
}
