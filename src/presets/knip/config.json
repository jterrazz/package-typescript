{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreDependencies": ["@jterrazz/test", "@jterrazz/typescript"],
    // The toolchain's own tools, and the six gestures of every repository's Makefile.
    "ignoreBinaries": ["gitleaks", "make", "oxfmt", "oxlint"],
    // An export used in its own file is not dead: a test exports what the same file's `afterAll` reads.
    "ignoreExportsUsedInFile": true,
    // The toolchain derives the oxlint config and hands it over; knip's plugin cannot judge it.
    "oxlint": false,
    // Setting `entry` replaces knip's default, so its two defaults lead; the command adds the build's entries.
    "entry": [
        "{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "src/{index,cli,main}.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
        "oxlint.config.ts",
        "oxfmt.config.ts",
        "jterrazz.config.ts",
        "vitest.config.ts"
    ]
}
