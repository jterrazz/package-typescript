{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "testRunner": "vitest",
    "vitest": {
        "configFile": "vitest.mutation.config.ts"
    },
    "coverageAnalysis": "perTest",
    "mutate": [
        "src/**/*.ts",
        "lint/**/*.ts",
        "!**/*.test.ts",
        "!**/*.test-d.ts",
        "!**/_fixtures/**",
        "!**/_expected/**",
        "!lint/self/corpus/findings.ts"
    ],
    "checkers": [],
    "disableTypeChecks": "{src,lint}/**/*.ts",
    "incremental": true,
    "incrementalFile": ".artifacts/stryker/incremental.json",
    "reporters": ["clear-text", "html", "json", "progress"],
    "htmlReporter": {
        "fileName": ".artifacts/stryker/report.html"
    },
    "jsonReporter": {
        "fileName": ".artifacts/stryker/report.json"
    },
    "timeoutMS": 30000,
    "concurrency": 8,
    "inPlace": true,
    "tempDirName": ".artifacts/stryker/tmp",
    "ignoreStatic": true
}
