#!/bin/sh
# A gitleaks that records what it was handed beside itself, in the working directory the spec reads, and finds nothing.
[ "$1" = version ] && exit 0
here="$(cd "$(dirname "$0")" && pwd -P)"
repository="$(dirname "$here")"
{
    echo "argv $*"
    case "$(pwd -P)" in
        "$repository"*) echo "scanned inside the repository" ;;
        *) echo "scanned beside the repository" ;;
    esac
    find . -type f | LC_ALL=C sort
} > "$here/record.txt"
exit 0
