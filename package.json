{
    "name": "@jterrazz/typescript",
    "version": "12.0.1",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jterrazz/package-typescript.git"
    },
    "bin": {
        "typescript": "dist/typescript.js"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "docs",
        "!docs/guides/test.md",
        "src/presets/**/*.json",
        "src/presets/**/*.toml"
    ],
    "type": "module",
    "imports": {
        "#checker": "./dist/checker.js",
        "#command": "./dist/command.js",
        "#mutant-checker": "./dist/mutant-checker.js",
        "#oxfmt-standin": "./dist/oxfmt-standin.js",
        "#oxlint-standin": "./dist/oxlint-standin.js",
        "#plugin": "./dist/plugin.js",
        "#rulebook": "./dist/rulebook.js"
    },
    "exports": {
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./docs": {
            "types": "./dist/docs.d.ts",
            "default": "./dist/docs.js"
        },
        "./oxfmt": {
            "types": "./dist/oxfmt.d.ts",
            "default": "./dist/oxfmt.js"
        },
        "./oxlint": {
            "types": "./dist/oxlint.d.ts",
            "default": "./dist/oxlint.js"
        },
        "./rules": {
            "types": "./dist/rules.d.ts",
            "browser": "./dist/rules.browser.js",
            "default": "./dist/rules.js"
        },
        "./tsconfig/*": "./src/presets/tsconfig/*.json",
        "./tsconfig/*.json": "./src/presets/tsconfig/*.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsdown src/commands/build/self-build.ts --no-config --out-dir .artifacts/bootstrap --logLevel warn && node .artifacts/bootstrap/self-build.mjs",
        "lint": "node dist/typescript.js check",
        "lint:fix": "node dist/typescript.js fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@ls-lint/ls-lint": "2.3.1",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/instrumenter": "^10.0.0",
        "@stryker-mutator/util": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@typescript/native": "npm:typescript@7.1.0-beta",
        "dependency-cruiser": "18.7.0",
        "eslint-plugin-perfectionist": "^5.12.0",
        "knip": "^6.42.1",
        "oxfmt": "^0.70.0",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "prettier": "^3.9.9",
        "prettier-plugin-astro": "^1.0.1",
        "publint": "^0.3.24",
        "rumdl": "0.3.0",
        "tsdown": "0.23.1",
        "typescript": "^6.0.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@jterrazz/test": "^19.0.0",
        "@jterrazz/typescript": "file:.",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "open": "^11.0.4",
        "react": "^19.3.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
