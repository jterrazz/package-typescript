{
    "name": "@jterrazz/typescript",
    "version": "11.0.0",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jterrazz/package-typescript.git"
    },
    "bin": {
        "typescript": "dist/typescript.js"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "docs",
        "!docs/guides/test.md",
        "src/presets/**/*.json",
        "src/presets/**/*.toml"
    ],
    "type": "module",
    "imports": {
        "#checker": "./dist/checker.js",
        "#command": "./dist/command.js",
        "#oxfmt-standin": "./dist/oxfmt-standin.js",
        "#oxlint-standin": "./dist/oxlint-standin.js",
        "#plugin": "./dist/plugin.js",
        "#rulebook": "./dist/rulebook.js"
    },
    "exports": {
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./docs": {
            "types": "./dist/docs.d.ts",
            "default": "./dist/docs.js"
        },
        "./oxfmt": {
            "types": "./dist/oxfmt.d.ts",
            "default": "./dist/oxfmt.js"
        },
        "./oxlint": {
            "types": "./dist/oxlint.d.ts",
            "default": "./dist/oxlint.js"
        },
        "./rules": {
            "types": "./dist/rules.d.ts",
            "browser": "./dist/rules.browser.js",
            "default": "./dist/rules.js"
        },
        "./tsconfig/*": "./src/presets/tsconfig/*.json",
        "./tsconfig/*.json": "./src/presets/tsconfig/*.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsdown src/command/self-build.ts --no-config --out-dir .artifacts/bootstrap --logLevel warn && node .artifacts/bootstrap/self-build.mjs",
        "lint": "node dist/typescript.js check",
        "lint:fix": "node dist/typescript.js fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@ls-lint/ls-lint": "2.3.1",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "dependency-cruiser": "18.4.0",
        "eslint-plugin-perfectionist": "^5.12.0",
        "knip": "^6.38.0",
        "oxfmt": "^0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2002",
        "prettier": "^3.9.9",
        "prettier-plugin-astro": "^1.0.1",
        "publint": "^0.3.24",
        "rumdl": "0.2.77",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.0"
    },
    "devDependencies": {
        "@jterrazz/test": "file:../package-test",
        "@jterrazz/typescript": "file:.",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "react": "^19.3.0",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@typescript/typescript-darwin-arm64": "^7.0.2",
        "@typescript/typescript-darwin-x64": "^7.0.2",
        "@typescript/typescript-linux-arm": "^7.0.2",
        "@typescript/typescript-linux-arm64": "^7.0.2",
        "@typescript/typescript-linux-x64": "^7.0.2",
        "@typescript/typescript-win32-arm64": "^7.0.2",
        "@typescript/typescript-win32-x64": "^7.0.2"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
