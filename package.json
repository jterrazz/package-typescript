{
    "name": "@jterrazz/typescript",
    "version": "11.0.0",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jterrazz/package-typescript.git"
    },
    "bin": {
        "typescript": "bin/typescript.sh"
    },
    "files": [
        "bin",
        "docs",
        "lint",
        "src",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!bin/commands/check-selection.sh",
        "!src/cli/check-passes.json"
    ],
    "type": "module",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./config": {
            "types": "./src/config.d.ts",
            "default": "./src/config.js"
        },
        "./docs": {
            "types": "./src/docs.d.ts",
            "default": "./src/docs.js"
        },
        "./oxfmt": {
            "types": "./src/oxfmt.d.ts",
            "default": "./src/oxfmt.js"
        },
        "./oxlint": {
            "types": "./src/oxlint.d.ts",
            "default": "./src/oxlint.js"
        },
        "./oxlint-config-names": "./src/cli/oxlint-config-names.json",
        "./tsconfig/*": "./src/presets/tsconfig/*.json",
        "./tsconfig/*.json": "./src/presets/tsconfig/*.json",
        "./tsdown/*": {
            "types": "./src/presets/tsdown/*.d.ts",
            "default": "./src/presets/tsdown/*.js"
        },
        "./tsdown/*.js": {
            "types": "./src/presets/tsdown/*.d.ts",
            "default": "./src/presets/tsdown/*.js"
        },
        "./presets/tsconfig/*": "./src/presets/tsconfig/*.json",
        "./presets/tsconfig/*.json": "./src/presets/tsconfig/*.json",
        "./presets/tsdown/*": {
            "types": "./src/presets/tsdown/*.d.ts",
            "default": "./src/presets/tsdown/*.js"
        },
        "./presets/tsdown/*.js": {
            "types": "./src/presets/tsdown/*.d.ts",
            "default": "./src/presets/tsdown/*.js"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "# no build script",
        "lint": "./bin/typescript.sh check",
        "lint:fix": "./bin/typescript.sh fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "dependency-cruiser": "^18.4.0",
        "eslint-plugin-perfectionist": "^5.12.0",
        "knip": "^6.38.0",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "oxlint-tsgolint": "7.0.2002",
        "prettier": "^3.9.9",
        "prettier-plugin-astro": "^1.0.1",
        "publint": "^0.3.24",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.0"
    },
    "devDependencies": {
        "@jterrazz/test": "file:../package-test",
        "@types/node": "^26.6.2",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@typescript/typescript-darwin-arm64": "^7.0.2",
        "@typescript/typescript-darwin-x64": "^7.0.2",
        "@typescript/typescript-linux-arm": "^7.0.2",
        "@typescript/typescript-linux-arm64": "^7.0.2",
        "@typescript/typescript-linux-x64": "^7.0.2",
        "@typescript/typescript-win32-arm64": "^7.0.2",
        "@typescript/typescript-win32-x64": "^7.0.2"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
